{
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit)",
      "Bash(npm test)",
      "Bash(npx vitest run *)",
      "Bash(npm run build -- --mode proba)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(deploy/protrima_proba.sh status)",
      "Bash(python3 .claude/hooks/test_straznik_proby.py)"
    ],
    "deny": [
      "Bash(deploy/deploy.sh *)",
      "Bash(./deploy/deploy.sh *)",
      "Bash(deploy/rollback.sh *)",
      "Bash(./deploy/rollback.sh *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Read(//opt/kebab/config/.env)",
      "Edit(//opt/kebab/app/**)",
      "Edit(//opt/kebab/kebab_new/**)",
      "Edit(//opt/kebab/config/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/straznik_proby.py"
          }
        ]
      }
    ]
  }
}
