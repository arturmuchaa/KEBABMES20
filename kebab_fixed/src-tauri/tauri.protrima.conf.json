{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PROTRIMA",
  "version": "0.5.0",
  "identifier": "pl.protrima.biuro",
  "build": {
    "beforeBuildCommand": "npm run build -- --mode produkcja",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PROTRIMA",
        "url": "protrima.html",
        "width": 1600,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; worker-src 'self' blob:; frame-src 'self' blob: data:; object-src 'self' blob: data:; connect-src 'self' http://91.98.105.107:8080",
      "capabilities": [
        "default",
        {
          "identifier": "protrima-okno",
          "description": "Własny pasek tytułu PROTRIMA: przeciąganie, minimalizacja, maksymalizacja, zamknięcie.",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:window:allow-start-dragging",
            "core:window:allow-minimize",
            "core:window:allow-toggle-maximize",
            "core:window:allow-is-maximized",
            "core:window:allow-close"
          ]
        }
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4NkZBOTM4RkYyRjdERUUKUldUdWZTLy9PS2x2U0Z2VnNZRkhMOEtIcXUyUkF0eUJkNTJmMEpzWGlkN090eGxkWG1yUjZJdWMK",
      "endpoints": [
        "http://91.98.105.107:8080/api/desktop-updates/protrima/latest.json"
      ],
      "dangerousInsecureTransportProtocol": true,
      "dialog": false
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Polish"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
